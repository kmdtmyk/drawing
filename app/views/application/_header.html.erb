<% color = ENV['RAILS_ENV'] == 'development' ? 'bg-primary' : 'bg-dark' %>
<header class='sticky-top'>
  <nav class='navbar navbar-expand-sm navbar-dark <%= color %>'>
    <a class='navbar-brand' href='/'>Top Page</a>
    <button class='navbar-toggler d-lg-none' type='button' data-toggle='collapse' data-target='#navbar' aria-controls='navbar' aria-expanded='false' aria-label='Toggle navigation'>
      <span class='navbar-toggler-icon'></span>
    </button>

    <div class='collapse navbar-collapse' id='navbar'>

      <ul class='navbar-nav mr-auto'>
        <li class='nav-item'>
          <%= link_to drawings_path, class: 'nav-link' do %>
            図面一覧 <span class='badge badge-light'><%= format_number Drawing.count %></span>
          <% end %>
        </li>
        <li class='nav-item'>
          <%= link_to '図面新規', new_drawing_path, class: 'nav-link' %>
        </li>
      </ul>

      <div class='navbar-nav'>
        <% if user_signed_in? %>
          <div class='dropdown'>
            <button class='btn btn-secondary dropdown-toggle' type='button' data-toggle='dropdown' aria-haspopup='true' aria-expanded='false'>
              <%= fa_icon 'user' %> <%= current_user.name %>
            </button>
            <div class='dropdown-menu dropdown-menu-right'>
              <%= link_to 'ユーザー情報変更', edit_user_path, class: 'dropdown-item' %>
              <%= link_to 'パスワード変更', edit_user_password_path, class: 'dropdown-item' %>
            </div>
          </div>
          <div class='nav-item'>
            <%= link_to 'ログアウト', destroy_user_session_path, method: :delete, class: 'nav-link' %>
          </div>
        <% end %>
      </div>

    </div>
  </nav>
</header>
