<% unless record.new_record? %>
  <small>
    <table>
      <tr>
        <th>作成者</th>
        <td><%= record.create_user_name %></td>
        <th>作成日時</th>
        <td><%= format_datetime record.created_at %></td>
      </tr>
      <tr>
        <th>更新者</th>
        <td><%= record.update_user_name %></td>
        <th>更新日時</th>
        <td><%= format_datetime record.updated_at %></td>
      </tr>
    </table>
  </small>
<% end %>
