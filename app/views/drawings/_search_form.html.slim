form
  .form-group.mb-2
    label 見積もり日
    .input-group.input-group-sm
      .input-group-prepend
        .input-group-text style='width: 4em' From
      = date_field_tag :estimate_date_from, params[:estimate_date_from], class: 'form-control form-control-sm'
    .input-group.input-group-sm
      .input-group-prepend
        .input-group-text style='width: 4em' To
      = date_field_tag :estimate_date_to, params[:estimate_date_to], class: 'form-control form-control-sm'

  .form-group.mb-2
    label 受注先
    select.form-control[name="customer_id"]
      option
      = @orders.each do |order|
        option value=order.id selected=(order.id.to_s == params[:customer_id])
          = order.name

  .form-group.mb-2
    label 品名
    = text_field_tag :product_name, params[:product_name], class: 'form-control'

  .form-group.mb-2
    label 品番
    = text_field_tag :part_number, params[:part_number], class: 'form-control'

  .form-group.mb-2
    label 材質
    = material_select 'material_id', params[:material_id], class: 'form-control'

  .form-group.mb-2
    label 加工種類
    = processing_type_select 'processing_type_id', params[:processing_type_id], class: 'form-control'

  .form-group.mb-2
    label 板厚
    .form-row.align-items-center
      .col= number_field_tag :thickness_from, params[:thickness_from], step: '0.01', class: 'form-control'
      span 〜
      .col= number_field_tag :thickness_to, params[:thickness_to], step: '0.01', class: 'form-control'

  .form-group.mb-2
    label 幅
    .form-row.align-items-center
      .col= number_field_tag :width_from, params[:width_from], step: '0.01', class: 'form-control'
      span 〜
      .col= number_field_tag :width_to, params[:width_to], step: '0.01', class: 'form-control'

  .form-group.mb-2
    label 長さ
    .form-row.align-items-center
      .col= number_field_tag :length_from, params[:length_from], step: '0.01', class: 'form-control'
      span 〜
      .col= number_field_tag :length_to, params[:length_to], step: '0.01', class: 'form-control'

  .form-group
    label 加工費
    .form-row.align-items-center
      .col= number_field_tag :process_cost_from, params[:process_cost_from], class: 'form-control'
      span 〜
      .col= number_field_tag :process_cost_to, params[:process_cost_to], class: 'form-control'

  button.btn.btn-info type='submit' 検索
