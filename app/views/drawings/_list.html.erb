<%= table_tag do %>
  <thead>
    <tr>
      <th>受注先</th>
      <th>品名</th>
      <th>品番</th>
      <th>見積もり日</th>
      <th></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% drawings.each do |drawing| %>
      <tr>
        <td><%= drawing.customer_name %></td>
        <td><%= drawing.product_name %></td>
        <td><%= drawing.part_number %></td>
        <td><%= format_date drawing.estimate_date %></td>
        <td>
          <%= link_to '詳細', drawing, class: 'btn btn-info btn-sm' %>
        </td>
        <td>
          <%= link_to '編集', edit_drawing_path(drawing), class: 'btn btn-primary btn-sm' %>
        </td>
      </tr>
    <% end %>
  </tbody>
<% end %>
