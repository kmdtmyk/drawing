<div class='mb-2'>

  <%= search_tag_label @search_params, :estimate_date_from, '見積もり日', suffix: '以降' %>

  <%= search_tag_label @search_params, :estimate_date_to, '見積もり日', suffix: '以前' %>

  <% customer = Customer.find_by(id: params[:customer_id]) %>
  <%= search_tag_label @search_params, :customer_id, '受注先',
    text: customer.try(:name) || '' %>

  <%= search_tag_label @search_params, :product_name, '品名' %>

  <%= search_tag_label @search_params, :part_number, '品番' %>

  <% material = Material.find_by(id: params[:material_id]) %>
  <%= search_tag_label @search_params, :material_id, '材質',
    text: material.try(:name) || '' %>

  <%= search_tag_label @search_params, :thickness_from, '板厚', suffix: '[mm]以上' %>

  <%= search_tag_label @search_params, :thickness_to, '板厚', suffix: '[mm]以下' %>

  <%= search_tag_label @search_params, :width_from, '幅', suffix: '[mm]以上' %>

  <%= search_tag_label @search_params, :width_to, '幅', suffix: '[mm]以下' %>

  <%= search_tag_label @search_params, :length_from, '長さ', suffix: '[mm]以上' %>

  <%= search_tag_label @search_params, :length_to, '長さ', suffix: '[mm]以下' %>

</div>
