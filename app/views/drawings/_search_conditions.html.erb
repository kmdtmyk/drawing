<div class='mb-2'>

  <% if params[:customer_id].present? %>
    <% customer = Customer.find_by(id: params[:customer_id]) %>
    <%= link_to drawings_path(params: params.merge(customer_id: '')) do %>
      <%= tag_label('受注先', customer.name) -%>
    <% end %>
  <% end %>

  <% if params[:product_name].present? %>
    <%= link_to drawings_path(params: params.merge(product_name: '')) do %>
      <%= tag_label('品名', params[:product_name]) -%>
    <% end %>
  <% end %>

  <% if params[:part_number].present? %>
    <%= link_to drawings_path(params: params.merge(part_number: '')) do %>
      <%= tag_label('品番', params[:part_number]) -%>
    <% end %>
  <% end %>

  <% if params[:material].present? %>
    <%= link_to drawings_path(params: params.merge(material: '')) do %>
      <%= tag_label('材質', params[:material]) -%>
    <% end %>
  <% end %>

  <% if params[:thickness_from].present? %>
    <%= link_to drawings_path(params: params.merge(thickness_from: '')) do %>
      <%= tag_label('板厚', format_number(params[:thickness_from]) + '[mm]以上') -%>
    <% end %>
  <% end %>

  <% if params[:thickness_to].present? %>
    <%= link_to drawings_path(params: params.merge(thickness_to: '')) do %>
      <%= tag_label('板厚', format_number(params[:thickness_to]) + '[mm]以下') -%>
    <% end %>
  <% end %>

  <% if params[:width_from].present? %>
    <%= link_to drawings_path(params: params.merge(width_from: '')) do %>
      <%= tag_label('幅', format_number(params[:width_from]) + '[mm]以上') -%>
    <% end %>
  <% end %>

  <% if params[:width_to].present? %>
    <%= link_to drawings_path(params: params.merge(width_to: '')) do %>
      <%= tag_label('幅', format_number(params[:width_to]) + '[mm]以下') -%>
    <% end %>
  <% end %>

  <% if params[:length_from].present? %>
    <%= link_to drawings_path(params: params.merge(length_from: '')) do %>
      <%= tag_label('長さ', format_number(params[:length_from]) + '[mm]以上') -%>
    <% end %>
  <% end %>

  <% if params[:length_to].present? %>
    <%= link_to drawings_path(params: params.merge(length_to: '')) do %>
      <%= tag_label('長さ', format_number(params[:length_to]) + '[mm]以下') -%>
    <% end %>
  <% end %>

  <% if params[:order_date_from].present? %>
    <%= link_to drawings_path(params: params.merge(order_date_from: '')) do %>
      <%= tag_label('受注日', params[:order_date_from] + ' 以降') -%>
    <% end %>
  <% end %>

  <% if params[:order_date_to].present? %>
    <%= link_to drawings_path(params: params.merge(order_date_to: '')) do %>
      <%= tag_label('受注日', params[:order_date_to] + ' 以前') -%>
    <% end %>
  <% end %>

  <% if params[:estimated_price_from].present? %>
    <%= link_to drawings_path(params: params.merge(estimated_price_from: '')) do %>
      <%= tag_label('見積金額',  format_number(params[:estimated_price_from]) + ' 以上') -%>
    <% end %>
  <% end %>

  <% if params[:estimated_price_to].present? %>
    <%= link_to drawings_path(params: params.merge(estimated_price_to: '')) do %>
      <%= tag_label('見積金額', format_number(params[:estimated_price_to]) + ' 以下') -%>
    <% end %>
  <% end %>

  <% if params[:categories].present? %>
    <% params[:categories].each_with_index do |category_id, index| %>
      <% category = Category.find_by(id: category_id) %>
      <% next if category.nil? %>
      <% other_categories = params[:categories].clone %>
      <% other_categories.delete_at(index) %>
      <%= link_to drawings_path(params: params.merge(categories: other_categories)) do %>
        <%= tag_label('カテゴリー', category.name) -%>
      <% end %>
    <% end %>
  <% end %>

</div>
