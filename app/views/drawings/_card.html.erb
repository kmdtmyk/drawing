<% name_map = Config::DrawingIndex.display_items.to_h.invert %>

<% drawings = drawings.includes(:thumbnail_drawing_file) %>

<div class='drawing-cards mb-4'>
  <% drawings.each do |drawing| %>
    <div class='drawing-card'>
      <div class='drawing-card-item'>
        <% if drawing.thumbnail.present? %>
          <%= link_to drawing do %>
            <%= drawing.thumbnail %>
          <% end %>
        <% end %>
        <table class='drawing-card-info'>
          <% @config.display_items.each do |item| %>
            <tr>
              <th><%= name_map[item] %></th>
              <td>
                <% if item == 'estimate_date' %>
                  <%= format_date drawing.estimate_date %>
                <% elsif item == 'order_customer' %>
                  <%= drawing.customer_name %>
                <% elsif item == 'product_name' %>
                  <%= drawing.product_name %>
                <% elsif item == 'part_number' %>
                  <%= drawing.part_number %>
                <% elsif item == 'material' %>
                  <%= drawing.material_name %>
                <% elsif item == 'processing_type' %>
                  <%= drawing.processing_type_name %>
                <% elsif item == 'thickness' %>
                  <%= format_number drawing.thickness %> [mm]
                <% elsif item == 'width' %>
                  <%= format_number drawing.width %> [mm]
                <% elsif item == 'length' %>
                  <%= format_number drawing.length %> [mm]
                <% elsif item == 'status' %>
                  <%= drawing.status %>
                <% elsif item == 'material_cost' %>
                  <%= format_number drawing.material_cost %>
                <% elsif item == 'process_cost' %>
                  <%= format_number drawing.process_cost %>
                <% elsif item == 'sales_price' %>
                  <%= format_number drawing.sales_price %>
                <% elsif item == 'memo' %>
                  <%= format_number drawing.memo %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </table>
        <div class='drawing-card-footer'>
          <%= link_to '詳細', drawing, class: 'btn btn-info btn-sm mr-2' %>
          <%= link_to '編集', edit_drawing_path(drawing), class: 'btn btn-primary btn-sm' %>
        </div>
      </div>
    </div>
  <% end %>
</div>
