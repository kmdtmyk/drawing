<div class='d-flex align-items-center'>

<h1>図面詳細</h1>
<%= link_to 'Edit', edit_drawing_path(@drawing), class: 'btn btn-info mx-2' %>
<%= link_to 'Destroy', @drawing, method: :delete, class: 'btn btn-danger mx-2', data: { confirm: 'Are you sure?' } %>

</div>

<div class='row'>

  <div class='col-sm-6'>
    <table class='table table-sm'>
      <tr>
        <th>受注先</th>
        <td><%= @drawing.customer.name %></td>
      </tr>
      <tr>
        <th>品名</th>
        <td><%= @drawing.product_name %></td>
      </tr>
      <tr>
        <th>品番</th>
        <td><%= @drawing.part_number %></td>
      </tr>
      <tr>
        <th>板厚</th>
        <td><%= @drawing.thickness %> [mm]</td>
      </tr>
      <tr>
        <th>幅</th>
        <td><%= @drawing.witdh %> [mm]</td>
      </tr>
      <tr>
        <th>長さ</th>
        <td><%= @drawing.length %> [mm]</td>
      </tr>
      <tr>
        <th>見積もり日</th>
        <td><%= @drawing.estimate_date %></td>
      </tr>
      <tr>
        <th>状態</th>
        <td><%= @drawing.status %></td>
      </tr>
      <tr>
        <th>材料費</th>
        <td><%= format_number @drawing.material_cost %></td>
      </tr>
      <tr>
        <th>加工費</th>
        <td><%= format_number @drawing.process_cost %></td>
      </tr>
      <tr>
        <th>売価</th>
        <td><%= format_number @drawing.sales_price %></td>
      </tr>
      <tr>
        <th>難易度</th>
        <td><%= @drawing.difficulty %></td>
      </tr>
      <tr>
        <th>カテゴリー</th>
        <td><%= @drawing.categories.pluck(:name).join('、') %></td>
      </tr>
      <tr>
        <th>外注先</th>
        <td>
          <% @drawing.drawing_outsources.each do |drawing_outsource| %>
            <div>
              <%= drawing_outsource.customer.name %>
              <%= format_number drawing_outsource.purchase_price %>
            </div>
          <% end %>
        </td>
      </tr>
    </table>
  </div>

  <div class='col-sm-6'>
    こっちに画像
  </div>

</div>

<%= link_to '戻る', drawings_path %>
