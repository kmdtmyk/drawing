<% content_for :sidebar do %>
  <div class='px-3'>
    <h2>検索条件</h2>
    <%= render 'search_form' %>
  </div>
<% end %>

<div class='px-4'>

  <p id='notice'><%= notice %></p>

  <h1>図面一覧</h1>

  <%= link_to '新規作成', new_drawing_path %>

  <%= paginate_statistic @drawings %>

  <div class='card-columns'>
    <% @drawings.each do |drawing| %>
      <div class='card' >
        <%= link_to drawing do %>
          <img class='card-img-top' src='https://placehold.jp/400x300.png'>
        <% end %>
        <div class='card-text'>
          <table>
            <tr>
              <th>品番</th>
              <td><%= drawing.part_number %></td>
            </tr>
            <tr>
              <th>受注日</th>
              <td><%= drawing.order_date %></td>
            </tr>
            <tr>
              <th>見積金額</th>
              <td><%= drawing.estimated_price %></td>
            </tr>
            <tr>
              <th>難易度</th>
              <td><%= drawing.difficulty %></td>
            </tr>
          </table>
        </div>
      </div>
    <% end %>
  </div>

  <%= paginate @drawings %>

</div>
