<% breadcrumb :drawings %>

<% @drawings = @drawings.includes(:drawing_files) %>

<% content_for :sidebar do %>
  <div class='px-3'>
    <h2>検索条件</h2>
    <%= render 'search_form' %>
  </div>
<% end %>

<div class=''>

  <div class='mb-2 d-flex justify-content-between'>

    <form class='form-inline'>
      <%= hidden_params except: :display_mode %>

      <label class='mr-2'>表示形式</label>
      <select class='form-control mr-2' name='display_mode'>
        <option value='card' <%= 'selected' if params[:display_mode] != 'list' %>>3列</option>
        <option value='list' <%= 'selected' if params[:display_mode] == 'list' %>>一覧</option>
      </select>
      <button type='submit' class='btn btn-info'>変更</button>
    </form>

    <%= link_to '新規作成', new_drawing_path, class: 'btn btn-primary' %>
  </div>

  <%= paginate_statistic @drawings %>

  <%= render 'search_conditions' %>

  <% if @drawings.empty? %>
    <p>検索条件に一致するデータが見つかりませんでした。</p>
  <% elsif params[:display_mode] == 'list' %>
    <%= render 'list', drawings: @drawings %>
  <% else %>
    <%= render 'card', drawings: @drawings %>
  <% end %>

  <%= paginate @drawings %>

</div>
