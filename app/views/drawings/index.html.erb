<% breadcrumb :drawings %>

<% @drawings = @drawings.includes(:drawing_files) %>

<% content_for :sidebar do %>
  <div class='px-3'>
    <h2>検索条件</h2>
    <%= render 'search_form' %>
  </div>
<% end %>

<div class='px-4'>

  <div class='mb-2'>
    <%= link_to '新規作成', new_drawing_path, class: 'btn btn-info' %>
  </div>

  <%= paginate_statistic @drawings %>

  <%= render 'search_conditions' %>

  <div class='card-columns'>
    <% @drawings.each do |drawing| %>
      <div class='card' >

        <% drawing_file = drawing.drawing_files.first %>
        <% if drawing_file.present? %>
          <%= link_to drawing do %>
            <% drawing_file.thumbnail style: 'width: 200px; height: 200px;' %>
          <% end %>
        <% end %>

        <div class='card-text px-2 py-1'>
          <table>
            <tr>
              <th>受注先</th>
              <td><%= drawing.customer_name %></td>
            </tr>
            <tr>
              <th>品名</th>
              <td><%= drawing.product_name %></td>
            </tr>
            <tr>
              <th>品番</th>
              <td><%= drawing.part_number %></td>
            </tr>
            <tr>
              <th>見積もり日</th>
              <td><%= drawing.estimate_date %></td>
            </tr>
            <!-- <tr>
              <th>見積金額</th>
              <td><%= format_number drawing.estimated_price %></td>
            </tr> -->
          </table>
        </div>

        <div class='card-footer d-flex justify-content-between'>
          <small class='text-muted'>
            <%= link_to '詳細', drawing %>
            <%= link_to '編集', edit_drawing_path(drawing) %>
          </small>
        </div>

      </div>
    <% end %>
  </div>

  <%= paginate @drawings %>

</div>
