<div class='sidebar-sticky'>
  <h2>検索条件</h2>
  <%= render 'search_form' %>
</div>

<div class='px-4'>

  <p id="notice"><%= notice %></p>

  <h1>Drawings</h1>

  <%= link_to '新規作成', new_drawing_path %>

  <table>
    <thead>
      <tr>
        <th>Part number</th>
        <th>Order date</th>
        <th>Estimated price</th>
        <th>Difficulty</th>
        <th colspan="3"></th>
      </tr>
    </thead>

    <tbody>
      <% @drawings.each do |drawing| %>
        <tr>
          <td><%= drawing.part_number %></td>
          <td><%= drawing.order_date %></td>
          <td><%= drawing.estimated_price %></td>
          <td><%= drawing.difficulty %></td>
          <td><%= link_to 'Show', drawing %></td>
          <td><%= link_to 'Edit', edit_drawing_path(drawing) %></td>
          <td><%= link_to 'Destroy', drawing, method: :delete, data: { confirm: 'Are you sure?' } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @drawings %>

</div>
