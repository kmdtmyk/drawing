<%= form_for(drawing) do |f| %>
  <% if drawing.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(drawing.errors.count, "error") %> prohibited this drawing from being saved:</h2>

      <ul>
      <% drawing.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :part_number %>
    <%= f.text_field :part_number %>
  </div>

  <div class="field">
    <%= f.label :order_date %>
    <%= f.date_field :order_date %>
  </div>

  <div class="field">
    <%= f.label :estimated_price %>
    <%= f.number_field :estimated_price %>
  </div>

  <div class="field">
    <%= f.label :difficulty %>
    <%= f.number_field :difficulty %>
  </div>

  <div class="field">
    <%= f.label :category %>
    <%= f.nested_fields_for :drawing_categories do |drawing_category| %>
      <%= drawing_category.collection_select :category_id, @categories, :id, :name, include_blank: true %>
    <% end %>
    <%= f.add_nested_fields_link :drawing_categories, '追加' %>
  </div>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>
