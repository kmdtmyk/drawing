<%= form_for(drawing) do |f| %>

  <div class='row'>

    <div class='col-sm-5'>

      <% if drawing.errors.any? %>
        <div id='error_explanation'>
          <h2><%= pluralize(drawing.errors.count, 'error') %> prohibited this drawing from being saved:</h2>
          <ul>
            <% drawing.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class='form-group'>
        <label>受注先</label>
        <%= f.collection_select :customer_id, @orders, :id, :name, {include_blank: true}, class: 'form-control' %>
      </div>

      <div class='form-group'>
        <label>品名</label>
        <%= f.text_field :product_name, class: 'form-control' %>
      </div>

      <div class='form-group'>
        <label>品番</label>
        <%= f.text_field :part_number, class: 'form-control' %>
      </div>

      <div class='form-group'>
        <label>材質</label>
        <%= f.collection_select :material_id, @materials, :id, :name, {include_blank: true}, class: 'form-control' %>
      </div>

      <div class='form-group'>
        <label>加工種類</label>
        <%= f.collection_select :processing_type_id, @processing_types, :id, :name, {include_blank: true}, class: 'form-control' %>
      </div>

      <div class='form-group'>
        <h3>材質</h3>
        <div class='form-row'>
          <div class='col'>
            <label>板厚</label>
            <%= f.number_field :thickness, step: '0.01', class: 'form-control' %>
          </div>
          <div class='col'>
            <label>幅</label>
            <%= f.number_field :width, step: '0.01', class: 'form-control' %>
          </div>
          <div class='col'>
            <label>長さ</label>
            <%= f.number_field :length, step: '0.01', class: 'form-control' %>
          </div>
        </div>
      </div>

      <div class='form-group'>
        <label>見積もり日</label>
        <%= f.date_field :estimate_date, class: 'form-control' %>
      </div>

      <div class='form-group form-row'>
        <div class='col'>
          <label>
            <%= f.check_box :estimate_flag %>
            見積もり
          </label>
        </div>
        <div class='col'>
          <label>
            <%= f.check_box :order_flag %>
            受注
          </label>
        </div>
        <div class='col'>
          <label>
            <%= f.check_box :suspend_flag %>
            保留
          </label>
        </div>
      </div>

      <div class='form-group form-row'>
        <div class='col'>
          <label>材料費</label>
          <%= f.number_field :material_cost, class: 'form-control' %>
        </div>
        <div class='col'>
          <label>加工費</label>
          <%= f.number_field :process_cost, class: 'form-control' %>
        </div>
        <div class='col'>
          <label>売価</label>
          <%= f.number_field :sales_price, class: 'form-control' %>
        </div>
      </div>

      <!-- <div class='form-group'>
        <label>見積金額</label>
        <%= f.number_field :estimated_price, class: 'form-control' %>
      </div>

      <div class='form-group'>
        <div>
          <label>カテゴリー</label>
          <%= f.add_nested_fields_link :drawing_categories, '追加' %>
        </div>
        <div class='form-inline'>
          <%= f.nested_fields_for :drawing_categories do |drawing_category| %>
            <%= drawing_category.collection_select :category_id, @categories, :id, :name, {include_blank: true}, class: 'form-control' %>
            <%= drawing_category.remove_nested_fields_link '削除' %>
          <% end %>
        </div>
      </div> -->

      <div class='form-group'>
        <table>
          <thead>
            <tr>
              <th>外注先</th>
              <th>仕入れ金額</th>
              <td>
                <%= f.add_nested_fields_link :drawing_outsources do %>
                  <button type='button' class='btn btn-info'>追加</button>
                <% end %>
              </td>
            </tr>
          </thead>

          <tbody>
            <%= f.nested_fields_for :drawing_outsources, wrapper_tag: :tr do |drawing_outsource| %>
              <td>
                <%= drawing_outsource.collection_select :customer_id, @outsources, :id, :name, {include_blank: true}, class: 'form-control' %>
              </td>
              <td>
                <%= drawing_outsource.number_field :purchase_price, class: 'form-control' %>
              </td>
              <td>
                <%= drawing_outsource.remove_nested_fields_link do %>
                  <button type='button' class='btn btn-warning'>削除</button>
                <% end %>
              </td>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class='form-group'>
        <label>メモ</label>
        <%= f.text_area :memo, class: 'form-control', rows: '3' %>
      </div>

      <div class='form-group'>
        <button type='submit' class='btn btn-primary'>登録</button>
      </div>

    </div>

    <div class='col-sm-7'>

      <%= table_tag do %>
        <%= f.nested_fields_for :drawing_files, wrapper_tag: :tr do |drawing_file| %>
          <% if drawing_file.object.new_record? %>
            <td colspan='2'><%= drawing_file.file_field :file %></td>
            <td><%= drawing_file.remove_nested_fields_link '削除' %></td>
          <% else %>
            <td><%= link_to drawing_file.object.name_with_icon, drawing_file.object.url %></td>
            <td><%= number_to_human_size drawing_file.object.file_file_size %></td>
            <td><%= drawing_file.remove_nested_fields_link '削除' %></td>
          <% end %>
        <% end %>
      <% end %>

      <%= f.add_nested_fields_link :drawing_files do %>
        <button type='button' class='btn btn-info'>追加</button>
      <% end %>

    </div>

  </div>

<% end %>
