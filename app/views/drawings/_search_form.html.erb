<form>
  <div class='form-group'>
    <label>品番</label>
    <%= text_field_tag :part_number, params[:part_number], class: 'form-control' %>
  </div>

  <div class='form-group'>
    <label>受注日</label>
    <div class='form-row align-items-center'>
      <div class='col'>
        <%= date_field_tag :order_date_from, params[:order_date_from], class: 'form-control' %>
      </div>
      <span>〜</span>
      <div class='col'>
        <%= date_field_tag :order_date_to, params[:order_date_to], class: 'form-control' %>
      </div>
    </div>
  </div>

  <div class='form-group'>
    <label>見積金額</label>
    <div class='form-row align-items-center'>
      <div class='col'>
        <%= number_field_tag :estimated_price_from, params[:estimated_price_from], class: 'form-control' %>
      </div>
      <span>〜</span>
      <div class='col'>
        <%= number_field_tag :estimated_price_to, params[:estimated_price_to], class: 'form-control' %>
      </div>
    </div>
  </div>

  <div class='form-group'>
    <label>難易度</label>
    <div class='form-row align-items-center'>
      <div class='col'>
        <%= number_field_tag :difficulty_from, params[:difficulty_from], class: 'form-control' %>
      </div>
      <span>〜</span>
      <div class='col'>
        <%= number_field_tag :difficulty_to, params[:difficulty_to], class: 'form-control' %>
      </div>
    </div>
  </div>

  <div class='form-group'>
    <label>カテゴリー</label>
    <%= text_field_tag :category, params[:category], class: 'form-control' %>
  </div>

  <button type='submit' class='btn btn-primary'>検索</button>
</form>
