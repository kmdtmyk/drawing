<form>
  <div class='form-group'>
    <label>受注先</label>
    <select name='customer_id' class='form-control'>
      <option></option>
      <%= @orders.each do |order| %>
        <option value='<%= order.id %>' <%= 'selected' if order.id.to_s == params[:customer_id] %>><%= order.name %></option>
      <% end %>
    </select>
  </div>

  <div class='form-group'>
    <label>品名</label>
    <%= text_field_tag :product_name, params[:product_name], class: 'form-control' %>
  </div>

  <div class='form-group'>
    <label>品番</label>
    <%= text_field_tag :part_number, params[:part_number], class: 'form-control' %>
  </div>

  <div class='form-group'>
    <label>材質</label>
    <%= text_field_tag :material, params[:material], class: 'form-control' %>
  </div>

  <div class='form-group'>
    <label>板厚</label>
    <div class='form-row align-items-center'>
      <div class='col'>
        <%= number_field_tag :thickness_from, params[:thickness_from], step: '0.01', class: 'form-control' %>
      </div>
      <span>〜</span>
      <div class='col'>
        <%= number_field_tag :thickness_to, params[:thickness_to], step: '0.01', class: 'form-control' %>
      </div>
    </div>
  </div>

  <div class='form-group'>
    <label>幅</label>
    <div class='form-row align-items-center'>
      <div class='col'>
        <%= number_field_tag :width_from, params[:width_from], step: '0.01', class: 'form-control' %>
      </div>
      <span>〜</span>
      <div class='col'>
        <%= number_field_tag :width_to, params[:width_to], step: '0.01', class: 'form-control' %>
      </div>
    </div>
  </div>

  <div class='form-group'>
    <label>長さ</label>
    <div class='form-row align-items-center'>
      <div class='col'>
        <%= number_field_tag :length_from, params[:length_from], step: '0.01', class: 'form-control' %>
      </div>
      <span>〜</span>
      <div class='col'>
        <%= number_field_tag :length_to, params[:length_to], step: '0.01', class: 'form-control' %>
      </div>
    </div>
  </div>

  <!-- <div class='form-group'>
    <label>見積もり日</label>
    <div class='form-row align-items-center'>
      <div class='col'>
        <%= text_field_tag :estimate_date_from, params[:estimate_date_from], class: 'form-control date-picker' %>
      </div>
      <span>〜</span>
      <div class='col'>
        <%= text_field_tag :estimate_date_to, params[:estimate_date_to], class: 'form-control date-picker' %>
      </div>
    </div>
  </div>

