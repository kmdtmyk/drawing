<form>

  <div>
    <label>品番</label>
    <%= text_field_tag :part_number, params[:part_number] %>
  </div>

  <div>
    <label>受注日</label>
    <%= date_field_tag :order_date_from, params[:order_date_from] %>
    〜
    <%= date_field_tag :order_date_to, params[:order_date_to] %>
  </div>

  <div>
    <label>見積金額</label>
    <%= number_field_tag :estimated_price_from, params[:estimated_price_from] %>
    〜
    <%= number_field_tag :estimated_price_to, params[:estimated_price_to] %>
  </div>

  <div>
    <label>難易度</label>
    <%= number_field_tag :difficulty_from, params[:difficulty_from] %>
    〜
    <%= number_field_tag :difficulty_to, params[:difficulty_to] %>
  </div>

  <button type='submit'>検索</button>
</form>
