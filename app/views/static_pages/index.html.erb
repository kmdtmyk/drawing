<div class='row'>

  <div class='col-sm-6'>

    <h3>メインメニュー</h3>

    <ul>
      <li><%= link_to '図面', drawings_path %></li>
      <li><%= link_to 'カテゴリー', categories_path %></li>
      <li><%= link_to '顧客', customers_path %></li>
      <li><%= link_to '材質', materials_path %></li>
      <li><%= link_to '統計', statistic_drawings_path %></li>
    </ul>

    <h3>管理者用メニュー</h3>

    <ul>
      <li><%= link_to 'ユーザー', users_path %></li>
      <li><%= link_to 'お知らせ', notices_path %></li>
    </ul>
  </div>

  <div class='col-sm-6'>
    <h3>お知らせ</h3>
    <% @notices.each do |notice| %>
      <div>
        <h5><%= notice.title %></h5>
        <div><%= simple_format notice.body %></div>
        <small><%= notice.post_datetime %></small>
      </div>
    <% end %>
  </div>

</div>
