<div class='row'>

  <div class='col-sm-6'>

    <h3>メインメニュー</h3>

    <ul>
      <li><%= link_to '図面', drawings_path %></li>
      <li><%= link_to '顧客', customers_path %></li>
      <li><%= link_to '材質', materials_path %></li>
      <li><%= link_to '加工種類', processing_types_path %></li>
      <li><%= link_to '統計', statistic_drawings_path %></li>
    </ul>

    <% if current_user.admin? %>
      <h3>管理者用メニュー</h3>
      <ul>
        <li><%= link_to 'ユーザー', admin_users_path %></li>
        <li><%= link_to 'お知らせ', notices_path %></li>
      </ul>
    <% end %>

  </div>

  <div class='col-sm-6'>
    <h3>お知らせ</h3>
    <hr>
    <% @notices.each do |notice| %>
      <div>
        <h5><%= notice.title %></h5>
        <%= simple_format notice.body, {}, wrapper_tag: :div %>
        <small><%= format_datetime notice.post_datetime %> <%= notice.update_user_name %></small>
      </div>
      <hr>
    <% end %>
  </div>

</div>
