<%= form_for(customer) do |f| %>
  <% if customer.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(customer.errors.count, "error") %> prohibited this customer from being saved:</h2>

      <ul>
      <% customer.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class='form-group row'>
    <label class='col-sm-2 col-form-label'>名前</label>
    <div>
      <%= f.text_field :name, class: 'form-control' %>
    </div>
  </div>

  <div class='form-group row'>
    <label class='col-sm-2 col-form-label'>略称</label>
    <div>
      <%= f.text_field :short_name, class: 'form-control' %>
    </div>
  </div>

  <div class='form-group row'>
    <label class='col-sm-2 col-form-label'>表示順</label>
    <div>
      <%= f.number_field :display_order, class: 'form-control' %>
    </div>
  </div>

  <div class='form-group row'>
    <label class='col-sm-2 col-form-label'>受注先</label>
    <div>
      <%= f.check_box :order_flag %>
    </div>
  </div>

  <div class='form-group row'>
    <label class='col-sm-2 col-form-label'>外注先</label>
    <div>
      <%= f.check_box :outsource_flag %>
    </div>
  </div>

  <div class='form-group'>
    <%= f.submit '登録', class: 'btn btn-primary' %>
  </div>

<% end %>

<% unless customer.new_record? %>
  <small>
    <table>
      <tr>
        <th>作成者</th>
        <td><%= customer.create_user_name %></td>
        <th>作成日時</th>
        <td><%= format_datetime customer.created_at %></td>
      </tr>
      <tr>
        <th>更新者</th>
        <td><%= customer.update_user_name %></td>
        <th>更新日時</th>
        <td><%= format_datetime customer.updated_at %></td>
      </tr>
    </table>
  </small>
<% end %>
