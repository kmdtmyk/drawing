<% breadcrumb :customers %>

<p>
  <%= link_to '新規作成', new_customer_path, class: 'btn btn-primary' %>
</p>

<%= table_tag do %>
  <thead>
    <tr>
      <th>名前</th>
      <th>略称</th>
      <th>受注先</th>
      <th>外注先</th>
      <th>表示順</th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @customers.each do |customer| %>
      <tr>
        <td><%= customer.name %></td>
        <td><%= customer.short_name %></td>
        <td><%= customer.order_flag %></td>
        <td><%= customer.outsource_flag %></td>
        <td><%= customer.display_order %></td>
        <td><%= link_to '編集', edit_customer_path(customer) %></td>
        <td><%= link_to '削除', customer, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
<% end %>
