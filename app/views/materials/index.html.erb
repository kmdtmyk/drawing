<% breadcrumb :materials %>

<p>
  <%= link_to '新規作成', new_material_path, class: 'btn btn-primary' %>
</p>

<%= table_tag do %>
  <thead>
    <tr>
      <th>名前</th>
      <th>表示順</th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @materials.each do |material| %>
      <tr>
        <td><%= material.name %></td>
        <td><%= material.display_order %></td>
        <td><%= link_to '編集', edit_material_path(material), class: 'btn btn-primary btn-sm' %></td>
        <td><%= link_to '削除', material, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger btn-sm' %></td>
      </tr>
    <% end %>
  </tbody>
<% end %>
