<%= form_for(material) do |f| %>
  <% if material.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(material.errors.count, "error") %> prohibited this material from being saved:</h2>

      <ul>
      <% material.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class='form-group row'>
    <label class='col-sm-2 col-form-label'>名前</label>
    <div>
      <%= f.text_field :name, class: 'form-control' %>
    </div>
  </div>

  <div class='form-group row'>
    <label class='col-sm-2 col-form-label'>表示順</label>
    <div>
      <%= f.number_field :display_order, class: 'form-control' %>
    </div>
  </div>

  <div class='form-group'>
    <%= f.submit '登録', class: 'btn btn-primary' %>
  </div>

<% end %>

<% unless material.new_record? %>
  <small>
    <table>
      <tr>
        <th>作成者</th>
        <td><%= material.create_user_name %></td>
        <th>作成日時</th>
        <td><%= format_datetime material.created_at %></td>
      </tr>
      <tr>
        <th>更新者</th>
        <td><%= material.update_user_name %></td>
        <th>更新日時</th>
        <td><%= format_datetime material.updated_at %></td>
      </tr>
    </table>
  </small>
<% end %>
